# Copy this file to pipeline/.env and put in the team's hessian.AI key (ask a teammate; never commit .env).
HAI_API_KEY=
HAI_BASE_URL=https://hip-gw.hessian.ai/v1
HAI_MODEL=vllm/Kolibri-1
# Optional: on a server others can reach, the Login tab then asks for this password.
# PIPELINE_PASSWORD=
# Optional: e-mail certificates from the server (without it, the page opens your mail program).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
